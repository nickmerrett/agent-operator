# ── Build stage ────────────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY api/              api/
COPY internal/         internal/
COPY cmd/agent-runtime/ cmd/agent-runtime/

# Build
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -a -ldflags="-w -s" -o /out/agent-runtime ./cmd/agent-runtime/...

# ── Runtime stage ───────────────────────────────────────────────────────────────
# Uses alpine (not distroless) so shell-exec and other tools that call /bin/sh work.
FROM alpine:3.19
RUN apk add --no-cache ca-certificates bash curl jq

COPY --from=builder /out/agent-runtime /agent-runtime

# Run as non-root
RUN addgroup -S agent && adduser -S agent -G agent
USER agent:agent
ENTRYPOINT ["/agent-runtime"]
