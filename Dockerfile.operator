# ── Build stage ────────────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY api/       api/
COPY internal/  internal/
COPY cmd/operator/ cmd/operator/

# Build
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -a -ldflags="-w -s" -o /out/operator ./cmd/operator/...

# ── Runtime stage ───────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static:nonroot

COPY --from=builder /out/operator /operator

USER 65532:65532
ENTRYPOINT ["/operator"]
